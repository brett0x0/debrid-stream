# Server Configuration
PORT=7000
HOST=0.0.0.0
NODE_ENV=production
ADDON_URL=http://localhost:7000
SECRET_KEY=change-this-to-a-secure-random-secret-key-32-chars

# Redis Cache (Optional - falls back to embedded persistent cache if empty)
REDIS_URL=

# Real-Debrid Rate Limits & Options
RD_REQUEST_TIMEOUT_MS=8000
PROVIDER_TIMEOUT_MS=3500
MAX_PARALLEL_PROVIDERS=6
LOG_LEVEL=info
